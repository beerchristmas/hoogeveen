, [-3.17, 287.56], [4.73, 284.0], [14.03, 281.08], [32.76, 277.88], [59.2, 291.57], [61.72, 292.97], [64.28, 294.4], [64.28, 300.16], [61.72, 303.32], [45.21, 315.94], [35.62, 320.26], [-1.14, 305.67], [-6.01, 302.98], [-7.89, 299.16]]]}, {"name": "Schippershuus", "note": "Rentmeesterskantoor van de Compagnie, later schipperscafé", "kind": "Rijksmonument · 17e eeuw", "text": "Het oudste gebouw van Hoogeveen, met een kern uit 1632 of 1633. De Compagnie van de 5000 Morgen liet het bouwen als kantoor van de rentmeester, waar de bewoners hun pacht kwamen betalen. De eerste rentmeester die we kennen is Carst Peters uit Hasselt. Na een verbouwing in 1882 werd het een café waar de turfschippers samenkwamen. Op het pleintje erachter staat een stenen huisje van één kamer dat doorgaat voor het oudste huis van Hoogeveen, uit 1630. Twee vrijwilligers van het museum hebben het in 2006 bekeken: het metselwerk is twintigste-eeuws en in het register van 1758 komt het huisje niet voor.", "address": "Hoofdstraat 254", "x": 228676.0, "y": 526478.0, "poly": [[[-9.9, -123.41], [2.18, -128.51], [6.74, -125.3], [6.74, -121.0], [4.64, -117.76], [-7.16, -112.76], [-9.9, -119.62]], [[240.05, -2.15], [246.82, -4.95], [257.02, 1.09], [257.02, 4.97], [253.55, 11.34], [243.51, 5.42], [242.57, 4.48], [240.05, 1.93]], [[-6.74, 125.3], [-6.51, 124.68], [-4.31, 123.73], [4.3, 120.03], [4.77, 120.31], [9.9, 123.41], [9.9, 127.2], [7.16, 130.75], [-4.64, 135.79], [-6.74, 129.59]], [[-257.02, -1.09], [-250.59, -3.37], [-249.35, -3.26], [-240.05, 2.15], [-240.05, 6.23], [-243.51, 12.58], [-253.55, 6.69], [-257.02, 2.78]]]}, {"name": "Huis met de Duivengaten", "kind": "Rijksmonument · eind 17e eeuw", "text": "Huis uit het eind van de 17e eeuw, met een gevel vol duivengaten, waterlijsten en pinakels. Het staat aan Het Kruis, de plek waar Hoogeveen begon. Nu is het een restaurant.", "address": "Alteveerstraat 1", "x": 228698.0, "y": 526431.0, "poly": [[[42.83, -130.38], [45.28, -131.8], [48.24, -133.5], [5