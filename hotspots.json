rt Metselaar zei de ontwerper zelf dat ze zich had laten inspireren door oosterse tuinen, niet door het veenverleden. Hij noemt het met een knipoog het grootste vruchtbaarheidssymbool van Nederland. De Cascaderun, waarvan de finish hier ligt, is ernaar genoemd.", "x": 228671.2, "y": 526796.5, "poly": [[[-235.04, -11.42], [-234.66, -12.37], [-233.58, -13.19], [-231.95, -13.73], [-230.04, -13.92], [-228.13, -13.73], [-226.5, -13.19], [-225.42, -12.37], [-225.04, -11.42], [-225.04, -8.82], [-225.42, -7.86], [-226.5, -7.05], [-228.13, -6.51], [-230.04, -6.32], [-231.95, -6.51], [-233.58, -7.05], [-234.66, -7.86], [-235.04, -8.82]], [[17.83, -115.02], [18.22, -115.98], [19.3, -116.79], [20.92, -117.33], [22.83, -117.52], [24.75, -117.33], [26.37, -116.79], [27.45, -115.98], [27.83, -115.02], [27.83, -112.42], [27.45, -111.47], [26.37, -110.65], [24.75, -110.11], [22.83, -109.92], [20.92, -110.11], [19.3, -110.65], [18.22, -111.47], [17.83, -112.42]], [[225.04, 11.42], [225.42, 10.46], [226.5, 9.65], [228.13, 9.11], [230.04, 8.92], [231.95, 9.11], [233.58, 9.65], [234.66, 10.46], [235.04, 11.42], [235.04, 14.02], [234.66, 14.97], [233.58, 15.78], [231.95, 16.33], [230.04, 16.52], [228.13, 16.33], [226.5, 15.78], [225.42, 14.97], [225.04, 14.02]], [[-27.83, 115.02], [-27.45, 114.06], [-26.37, 113.25], [-24.75, 112.71], [-22.83, 112.52], [-20.92, 112.71], [-19.3, 113.25], [-18.22, 114.06], [-17.83, 115.02], [-17.83, 117.62], [-18.22, 118.57], [-19.3, 119.39], [-20.92, 119.93], [-22.83, 120.12], [-24.75, 119.93], [-26.37, 119.39], [-27.45, 118.57], [-27.83, 117.62]]]}, {"name": "De Tas", "kind": "Kunstwerk · 1999", "text": "Boodschappentas van Gert-Jan Mulder bij de ingang van de Tamboerpassage, geplaatst toen het winkelcentrum in 1999 openging. Hij kostte 95.000 gulden.", "x": 228654.2, "y": 527188.0, "poly": [[[-523.93, 120.99], [-523.55, 120.03], [-522.47, 119.22], [-520.85, 118.68], [-518.93, 118.49], [-517.02, 118.68], [-515.4, 119.22], [-514.31, 120.03], [-513.93, 120.